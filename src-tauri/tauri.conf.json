{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Services",
  "version": "0.1.0",
  "identifier": "dev.atabaev.services",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Сервис — ремонт оборудования",
        "width": 1180,
        "height": 780,
        "minWidth": 880,
        "minHeight": 540,
        "center": true
      },
      {
        "label": "widget",
        "url": "widget.html",
        "title": "Сервис — виджет",
        "width": 380,
        "height": 560,
        "minWidth": 300,
        "minHeight": 320,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "app", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"]
      }
    }
  }
}
